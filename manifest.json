{
  "manifest_version": 3,
  "name": "Affiliate Pin Saver",
  "version": "1.0.0",
  "description": "Save Amazon affiliate product pins to Pinterest directly from Facebook group posts.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Affiliate Pin Saver"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://*.amazon.com/*",
    "https://amzn.to/*",
    "https://a.co/*",
    "https://pinterest.com/*",
    "https://www.pinterest.com/*"
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://facebook.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*"
      ]
    }
  ]
}
